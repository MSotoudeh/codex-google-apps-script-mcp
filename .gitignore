# Dependencies and package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and credentials
.env
.env.*
!.env.example
.clasprc.json
clasprc.json
credentials.json
token.json
*.pem
*.key

# Google clasp / Apps Script local state
# In real private Apps Script repos, .clasp.json may be intentionally committed.
# In this public setup template, keep real script bindings out of the repo.
.clasp.json
.claspignore.local
appsscript.local.json

# Local Codex / MCP machine-specific config
.mcp.json

# Local Apps Script output and temporary smoke-test projects
gas-smoke/
*-smoke/

# Temporary folders
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and generated files
*.log
dist/
build/
coverage/
